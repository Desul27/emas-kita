generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ MULTI-CABANG ============

model Toko {
  id        String   @id @default(cuid())
  nama      String
  alamat    String?
  mataUang  String   @default("IDR")
  tema      String   @default("light")
  bahasa    String   @default("id")

  // Aturan kalkulator (mode "default" = semua aturan standar aktif,
  // mode "kustom" = ikut tiga flag di bawah)
  modeKalkulator      String  @default("default")
  bulatkanBeratKering Boolean @default(true)
  bulatkanKadar       Boolean @default(true)
  cetakStruk          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id])

  hargaEmasHarian HargaEmasHarian[]
  transaksi       Transaksi[]

  @@index([ownerId])
  @@map("toko")
}

// ============ AKUN & SESI ============
// SUPER_ADMIN : pengelola sistem (login email/username + kata sandi)
// PEMILIK_TOKO: pemilik usaha (login username + PIN 6 digit), dibuat oleh Super Admin

enum Role {
  SUPER_ADMIN
  PEMILIK_TOKO
}

enum StatusAkun {
  AKTIF
  DITUTUP // akses dashboard ditutup oleh Super Admin
}

model User {
  id           String     @id @default(cuid())
  username     String     @unique // huruf kecil
  email        String?    @unique // wajib untuk SUPER_ADMIN (ganti kata sandi), opsional untuk lainnya
  nama         String
  role         Role       @default(PEMILIK_TOKO)
  status       StatusAkun @default(AKTIF)
  passwordHash String // hash PIN / kata sandi (scrypt + pepper)

  // Anti brute force
  gagalLogin     Int       @default(0)
  terkunciSampai DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sesi Sesi[]
  toko Toko[]

  @@map("users")
}

model Sesi {
  id            String   @id // SHA-256 dari token di cookie
  userId        String
  berlakuSampai DateTime
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sesi")
}

// ============ HARGA EMAS HARIAN ============

model HargaEmasHarian {
  id           String   @id @default(cuid())
  tanggal      DateTime @default(now())
  hargaPerGram Float
  createdAt    DateTime @default(now())

  tokoId String
  toko   Toko   @relation(fields: [tokoId], references: [id])

  @@unique([tokoId, tanggal])
  @@index([tokoId])
  @@map("harga_emas_harian")
}

// ============ TABEL REFERENSI BERAT JENIS -> KADAR ============
// Sumber: buku referensi fisik toko (kolom Cu=0, Ag=100)

model ReferensiKadar {
  id          String @id @default(cuid())
  bj          Float  @unique
  kadarPersen Float

  @@index([bj])
  @@map("referensi_kadar")
}

// ============ TRANSAKSI ============
// Toko HANYA membeli kepingan emas dari pelanggan (bukan jual barang katalog).
// Setiap kedatangan pelanggan = 1 transaksi. "Stok" dihitung dari SUM
// beratKering, bukan angka terpisah yang disimpan manual.

model Transaksi {
  id            String   @id @default(cuid())
  kodeTransaksi String   @unique
  tanggal       DateTime @default(now())

  beratKeringAsli Float // Bk hasil timbangan, sebelum pembulatan (audit)
  beratKering     Float // Bk yang dipakai untuk hitung Th (sesudah aturan pembulatan)
  beratBasah      Float // Bb
  bj              Float // Bj = Bk / (Bk - Bb), selalu dari angka asli
  kadarAsli       Float // Kd hasil lookup tabel referensi, sebelum pembulatan (audit)
  kadarPersen     Float // Kd yang dipakai untuk hitung Th (sesudah aturan pembulatan)
  hargaPerGram    Float // Hp efektif = harga harian x kadarPersen
  totalHarga      Float // Th = beratKering x hargaPerGram

  namaPelanggan String?

  tokoId String
  toko   Toko   @relation(fields: [tokoId], references: [id])

  @@index([tokoId, tanggal])
  @@map("transaksi")
}
