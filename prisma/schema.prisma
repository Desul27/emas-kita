generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ MULTI-CABANG ============

model Toko {
  id        String   @id @default(cuid())
  nama      String
  alamat    String?
  mataUang  String   @default("IDR")
  tema      String   @default("light")
  bahasa    String   @default("id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  hargaEmasHarian HargaEmasHarian[]
  transaksi       Transaksi[]

  @@map("toko")
}

// ============ USER / KASIR ============

enum Role {
  ADMIN
  KASIR
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  nama      String
  role      Role     @default(KASIR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tokoId String
  toko   Toko   @relation(fields: [tokoId], references: [id])

  @@index([tokoId])
  @@map("users")
}

// ============ HARGA EMAS HARIAN ============

model HargaEmasHarian {
  id           String   @id @default(cuid())
  tanggal      DateTime @default(now())
  hargaPerGram Float
  createdAt    DateTime @default(now())

  tokoId String
  toko   Toko   @relation(fields: [tokoId], references: [id])

  @@unique([tokoId, tanggal])
  @@index([tokoId])
  @@map("harga_emas_harian")
}

// ============ TABEL REFERENSI BERAT JENIS -> KADAR ============
// Sumber: buku referensi fisik toko (kolom Cu=0, Ag=100)

model ReferensiKadar {
  id          String @id @default(cuid())
  bj          Float  @unique
  kadarPersen Float

  @@index([bj])
  @@map("referensi_kadar")
}

// ============ TRANSAKSI ============
// Toko HANYA membeli kepingan emas dari pelanggan (bukan jual barang katalog).
// Setiap kedatangan pelanggan = 1 transaksi. "Stok" dihitung dari SUM
// beratKering, bukan angka terpisah yang disimpan manual.

model Transaksi {
  id            String   @id @default(cuid())
  kodeTransaksi String   @unique
  tanggal       DateTime @default(now())

  beratKering  Float // Bk
  beratBasah   Float // Bb
  bj           Float // Bj = Bk / (Bk - Bb)
  kadarPersen  Float // Kd
  hargaPerGram Float // Hp
  totalHarga   Float // Th = Bk x Kd x Hp

  namaPelanggan String?

  tokoId String
  toko   Toko   @relation(fields: [tokoId], references: [id])

  @@index([tokoId, tanggal])
  @@map("transaksi")
}